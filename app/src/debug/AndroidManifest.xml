<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Starts the Trace SDK in the terminal process too, which the SDK's own provider does not
             reach: it reads the logcat of its own process only. -->
        <provider
            android:name=".TerminalTraceProvider"
            android:authorities="${applicationId}.terminal-trace"
            android:exported="false"
            android:process=":terminal" />
    </application>

</manifest>
