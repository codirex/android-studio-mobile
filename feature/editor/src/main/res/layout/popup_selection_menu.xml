<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menu_cut"
                style="@style/Widget.Asm.SelectionMenuItem"
                android:drawableTop="@drawable/ic_sel_cut"
                android:text="@string/editor_action_cut" />

            <TextView
                android:id="@+id/menu_copy"
                style="@style/Widget.Asm.SelectionMenuItem"
                android:drawableTop="@drawable/ic_sel_copy"
                android:text="@string/editor_action_copy" />

            <TextView
                android:id="@+id/menu_paste"
                style="@style/Widget.Asm.SelectionMenuItem"
                android:drawableTop="@drawable/ic_sel_paste"
                android:text="@string/editor_action_paste" />

            <TextView
                android:id="@+id/menu_select_all"
                style="@style/Widget.Asm.SelectionMenuItem"
                android:drawableTop="@drawable/ic_sel_select_all"
                android:text="@string/editor_action_select_all" />
        </LinearLayout>

        <!-- Language actions: shown only when the language server of the file is ready. -->
        <LinearLayout
            android:id="@+id/menu_code_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_code_row"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/menu_definition"
                    style="@style/Widget.Asm.SelectionMenuItem"
                    android:drawableTop="@drawable/ic_sel_definition"
                    android:text="@string/editor_java_definition"
                    android:textColor="?attr/colorPrimary"
                    android:drawableTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/menu_info"
                    style="@style/Widget.Asm.SelectionMenuItem"
                    android:drawableTop="@drawable/ic_sel_info"
                    android:text="@string/editor_java_hover"
                    android:textColor="?attr/colorPrimary"
                    android:drawableTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/menu_format"
                    style="@style/Widget.Asm.SelectionMenuItem"
                    android:drawableTop="@drawable/ic_sel_format"
                    android:text="@string/editor_java_format"
                    android:textColor="?attr/colorPrimary"
                    android:drawableTint="?attr/colorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
