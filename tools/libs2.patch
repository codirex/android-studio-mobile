+              String subtitle = symbol.kindName();
+              if (!symbol.container().isEmpty()) {
+                subtitle += " - " + symbol.container();
+              }
+              built.add(
+                  PaletteItem.file(
+                      symbol.name(),
+                      subtitle + " - " + path,
+                      symbol.name(),
+                      R.drawable.ic_palette_symbol,
+                      () -> host.paletteOpenFileAt(path, line)));
+            }
+          }
+          workspaceItems = built;
+          refresh();
+        });
+  }
